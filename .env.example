NEXT_PUBLIC_API_URL=http://localhost:8000
ARCHFLOW_UPLOAD_DIR=.local/uploads
ARCHFLOW_PROJECT_DIR=.local/projects
ARCHFLOW_CASE_UPLOAD_DIR=.local/cases
ARCHFLOW_DATABASE_PATH=.local/archflow.sqlite3
ARCHFLOW_ALLOWED_ORIGINS=http://localhost:3000
ARCHFLOW_GITHUB_REPOSITORY=jingwenadc/archflow
ARCHFLOW_GITHUB_BASE_BRANCH=main
# Use a GitHub App installation token in production. Never expose this value to the browser.
ARCHFLOW_GITHUB_TOKEN=
# Optional agent worker. Configure both API and worker; no model keys in NEXT_PUBLIC variables.
ARCHFLOW_AGENT_ENABLED=false
ARCHFLOW_WORKER_TOKEN=
# Set a long random code to enable individual accounts (local HTTP: cookie secure=false).
# Only the API receives this; it is never a NEXT_PUBLIC variable.
ARCHFLOW_SIGNUP_CODE=
ARCHFLOW_COOKIE_SECURE=false
ARCHFLOW_LLM_BASE_URL=
ARCHFLOW_LLM_API_KEY=
ARCHFLOW_LLM_MODEL=gpt-6-astra
ARCHFLOW_REVIEW_MODEL=gpt-6-astra
# Local worker (Docker overrides this to http://api:8000).
ARCHFLOW_API_URL=http://localhost:8000
# auto resolves the official limit from each job's generation/review model ID.
# Set a number only if your gateway has a smaller limit or uses an unknown model alias.
ARCHFLOW_LLM_CONTEXT_WINDOW=auto
ARCHFLOW_LLM_MAX_OUTPUT_TOKENS=8192
