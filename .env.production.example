# Copy to .env.production. Never commit the real file.
COMPOSE_PROJECT_NAME=archflow
ARCHFLOW_DOMAIN=archflow.example.com
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# Production server: /data/archflow. Local test: ./.local/deployment-data
ARCHFLOW_DATA_DIR=/data/archflow
ARCHFLOW_BACKUP_DIR=/data/archflow-backups
BACKUP_RETENTION_DAYS=14

# The browser uses same-origin /api routes through Nginx.
NEXT_PUBLIC_API_URL=
ARCHFLOW_ALLOWED_ORIGINS=https://archflow.example.com
ARCHFLOW_GITHUB_REPOSITORY=jingwenadc/archflow
ARCHFLOW_GITHUB_BASE_BRANCH=main
# Use a GitHub App installation token in production. Leave empty until configured.
ARCHFLOW_GITHUB_TOKEN=

# Opt-in Pi agent. Secrets stay server-side; these are NOT NEXT_PUBLIC variables.
# Keep false until the worker endpoint/key and private worker token are configured.
ARCHFLOW_AGENT_ENABLED=false
ARCHFLOW_WORKER_TOKEN=
ARCHFLOW_LLM_BASE_URL=
ARCHFLOW_LLM_API_KEY=
ARCHFLOW_LLM_MODEL=gpt-5.5
ARCHFLOW_REVIEW_MODEL=gpt-5.5
# Conservative operational limits; verify your endpoint's supported limits.
ARCHFLOW_LLM_CONTEXT_WINDOW=32768
ARCHFLOW_LLM_MAX_OUTPUT_TOKENS=8192

# Username is safe to store here. Generate deploy/nginx/.htpasswd separately;
# never store the shared plaintext password in this file.
BASIC_AUTH_USERNAME=archflow

# Required for Let's Encrypt certificate requests and expiry notices.
LETSENCRYPT_EMAIL=admin@example.com
LETSENCRYPT_STAGING=1
ACME_WEBROOT_DIR=/data/letsencrypt/www
LETSENCRYPT_CONFIG_DIR=/data/letsencrypt/config
