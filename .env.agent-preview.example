# Copy this file to .env.agent-preview and fill in the secrets locally.
# .env.agent-preview is explicitly ignored by Git.
COMPOSE_PROJECT_NAME=archflow-agent-preview
ARCHFLOW_DOMAIN=localhost
BIND_ADDRESS=127.0.0.1
HTTP_PORT=18081
ARCHFLOW_DATA_DIR=./.local/agent-preview-data
NEXT_PUBLIC_API_URL=
ARCHFLOW_ALLOWED_ORIGINS=http://127.0.0.1:18081,http://localhost:18081

# Set true after configuring the endpoint, key, and worker token.
ARCHFLOW_AGENT_ENABLED=false
ARCHFLOW_WORKER_TOKEN=

# Use the API base URL (normally ending in /v1), not /responses.
ARCHFLOW_LLM_BASE_URL=
ARCHFLOW_LLM_API_KEY=
ARCHFLOW_LLM_MODEL=gpt-6-astra
ARCHFLOW_REVIEW_MODEL=gpt-6-astra
ARCHFLOW_LLM_CONTEXT_WINDOW=auto
ARCHFLOW_LLM_MAX_OUTPUT_TOKENS=8192
